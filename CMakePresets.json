{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MBEVOCODER_BUILD_TOOLS": "ON",
        "MBEVOCODER_BUILD_TESTS": "ON",
        "MBEVOCODER_BUILD_BENCH": "ON"
      }
    },
    { "name": "debug",   "inherits": "base", "displayName": "Debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "displayName": "Release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Debug + ASan/UBSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MBEVOCODER_ENABLE_ASAN": "ON", "MBEVOCODER_ENABLE_UBSAN": "ON" }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Debug + TSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MBEVOCODER_ENABLE_TSAN": "ON" }
    },
    {
      "name": "strict-fp",
      "inherits": "base",
      "displayName": "Release, strict floating point",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MBEVOCODER_STRICT_FP": "ON" }
    },
    {
      "name": "neo-compat",
      "inherits": "base",
      "displayName": "Verification: mbelib-neo compatible (MBEVOCODER_CHIP_MEASURED off, mbelib-neo 2.1 parity to float rounding; not a build to ship)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MBEVOCODER_STRICT_FP": "ON", "MBEVOCODER_CHIP_MEASURED": "OFF", "MBEVOCODER_FLOAT_CLIP": "ON" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "MBEVOCODER_BUILD_TOOLS": "ON", "MBEVOCODER_BUILD_TESTS": "ON", "MBEVOCODER_BUILD_BENCH": "ON" }
    },
    {
      "name": "android-arm64",
      "inherits": "base",
      "displayName": "Android arm64-v8a",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "MBEVOCODER_BUILD_TOOLS": "OFF",
        "MBEVOCODER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-armv7",
      "inherits": "android-arm64",
      "displayName": "Android armeabi-v7a",
      "cacheVariables": { "ANDROID_ABI": "armeabi-v7a" }
    },
    {
      "name": "android-x86_64",
      "inherits": "android-arm64",
      "displayName": "Android x86_64",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "debug",      "configurePreset": "debug" },
    { "name": "release",    "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan",       "configurePreset": "tsan" },
    { "name": "strict-fp",  "configurePreset": "strict-fp" },
    { "name": "neo-compat", "configurePreset": "neo-compat" },
    { "name": "vs2026",     "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "android-arm64",  "configurePreset": "android-arm64" },
    { "name": "android-armv7",  "configurePreset": "android-armv7" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" }
  ],
  "testPresets": [
    { "name": "debug",      "configurePreset": "debug",      "output": { "outputOnFailure": true } },
    { "name": "release",    "configurePreset": "release",    "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "tsan",       "configurePreset": "tsan",       "output": { "outputOnFailure": true } },
    { "name": "strict-fp",  "configurePreset": "strict-fp",  "output": { "outputOnFailure": true } },
    { "name": "neo-compat", "configurePreset": "neo-compat", "output": { "outputOnFailure": true } },
    { "name": "vs2026",     "configurePreset": "vs2026",     "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
