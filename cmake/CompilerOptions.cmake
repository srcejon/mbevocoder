# Shared compiler flags for library, tools and tests.

function(mbevocoder_apply_compiler_options target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /Zc:__cplusplus /utf-8)
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
        if(MBEVOCODER_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE /WX)
        endif()
        if(MBEVOCODER_STRICT_FP)
            target_compile_options(${target} PRIVATE /fp:strict)
        else()
            target_compile_options(${target} PRIVATE /fp:precise)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-sign-conversion)
        if(MBEVOCODER_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
        if(MBEVOCODER_STRICT_FP)
            target_compile_options(${target} PRIVATE -ffp-contract=off -fno-fast-math)
        endif()
    endif()

    set(_san "")
    if(MBEVOCODER_ENABLE_ASAN)
        list(APPEND _san address)
    endif()
    if(MBEVOCODER_ENABLE_UBSAN)
        list(APPEND _san undefined)
    endif()
    if(MBEVOCODER_ENABLE_TSAN)
        list(APPEND _san thread)
    endif()
    if(_san)
        if(MSVC)
            if(MBEVOCODER_ENABLE_ASAN)
                target_compile_options(${target} PRIVATE /fsanitize=address)
            endif()
        else()
            string(REPLACE ";" "," _san_flag "${_san}")
            target_compile_options(${target} PRIVATE -fsanitize=${_san_flag} -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=${_san_flag})
        endif()
    endif()
endfunction()
